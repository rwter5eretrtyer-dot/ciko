{
  "name": "ciko-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/utils/migrate.ts",
    "seed": "tsx src/utils/seed.ts",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude tests/integration.test.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:coverage": "vitest run --coverage --exclude tests/integration.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2", "cookie-parser": "^1.4.7", "cors": "^2.8.5",
    "dotenv": "^16.5.0", "express": "^5.1.0", "express-rate-limit": "^8.0.0",
    "jsonwebtoken": "^9.0.2", "multer": "^2.0.2", "pg": "^8.16.0",
    "swagger-ui-express": "^5.0.1", "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0", "@types/bcryptjs": "^2.4.6", "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19", "@types/express": "^5.0.3", "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0", "@types/node": "^22.15.0", "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.2", "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.30.0", "globals": "^16.3.0", "prettier": "^3.6.0",
    "supertest": "^7.1.3", "tsx": "^4.20.0", "typescript": "^5.9.0",
    "typescript-eslint": "^8.35.0", "vitest": "^3.2.0", "@vitest/coverage-v8": "^3.2.0"
  }
}
